{
  "name": "bmfk",
  "version": "0.0.0",
  "private": true,
  "description": "bmfk \u2014 Backend Modular Framework Kit (monorepo)",
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ],
  "scripts": {
    "build": "npm run build -w @bmfk/monitor && npm run build -w @bmfk/api-docs && npm run build -w @bmfk/api",
    "test": "npm test -w @bmfk/api",
    "monitor": "npm run dev -w @bmfk/monitor",
    "website": "npm run build -w bmfk-website",
    "api-docs": "npm run dev -w @bmfk/api-docs",
    "sandbox": "npm run build && npm run build -w @bmfk/sandbox && npm start -w @bmfk/sandbox"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
